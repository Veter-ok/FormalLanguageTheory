$ENTRY Go {
  = <Prout 'Введите правило (например, ^XaaYZ$ = ^XZXaYX$):'>
    <Prout <GenerateSRS <Get 0>>>;
}

GenerateSRS {
  e.Input =
    <ValidateSyntax e.Input> :
      {
        True =
          <ValidateVariables e.Input> :
            {
              True = <GenerateSRSValid e.Input>;
              False = 'Ошибка: переменная из правой части отсутствует в левой.\n';
            };
        False = 'Ошибка: некорректный формат правила.\n';
      };
}

GenerateSRSValid {
  e.LeftSide '=' e.RightSide
    = '----Оборачивание переменных в скобки----\n'
      <TakeVarInBrackets (1) <Tokenize () e.LeftSide>>
      '---------Удаление всех литералов--------\n'
      <DeleteAllLiterals
        (<CountVars (0) <Tokenize () e.LeftSide>>)
        <Tokenize () e.LeftSide>>
      '---------Копирование переменных---------\n'
      <CopyingVars
        <PutNum <Tokenize () e.LeftSide> (<Tokenize () e.LeftSide>)>
        (<PutNum <Tokenize () e.RightSide> (<Tokenize () e.LeftSide>)>)
        1
        ()>
      '------------Вставка литералов-----------\n'
      <PutLits <PutNum <Tokenize () e.RightSide> (<Tokenize () e.LeftSide>)>>
      '-------------Удаление скобок------------\n'
      <DeleteBrackets <PutNum <Tokenize () e.RightSide> (<Tokenize () e.LeftSide>)>>;
}

ValidateSyntax {
  '^' e.Left '$ = ^' e.Right '$'
    = <ContainsReserved e.Left> :
      {
        True = False;
        False = <ContainsReserved e.Right> :
          {
            True = False;
            False = True;
          };
      };

  e.Input = False;
}

ContainsReserved {
  e.Before '^' e.After = True;
  e.Before '$' e.After = True;
  e.Before '=' e.After = True;
  e.Input = False;
}

ValidateVariables {
  e.LeftSide '=' e.RightSide 
    = <CheckRightVars <Tokenize () e.RightSide> (<Tokenize () e.LeftSide>)>;
}

CheckRightVars {
  (Var s.Name) e.RightRest (e.LeftVars) = <HasVar (Var s.Name) (e.LeftVars)> :
    {
      True = <CheckRightVars e.RightRest (e.LeftVars)>;
      False = False;
    };
  (s.Type e.Symbols) e.RightRest (e.LeftVars) = <CheckRightVars e.RightRest (e.LeftVars)>;
  () (e.LeftVars) = True;
}


HasVar {
  (Var s.Name) ((Var s.Name) e.Rest) = True;
  (Var s.Name) ((Var s.Other) e.Rest) = <HasVar (Var s.Name) (e.Rest)>;
  (Var s.Name) ((s.Type e.Symbols) e.Rest) = <HasVar (Var s.Name) (e.Rest)>;
  (Var s.Name) () = False;
}

Tokenize {
  () s.Symbol e.Rest = <IsSpace s.Symbol> :
    {
      True  = <Tokenize () e.Rest>;
      False = <IsUpper (<Variables>) s.Symbol> :
          {
            True  = (Var s.Symbol) <Tokenize () e.Rest>;
            False = <IsEndOrStart s.Symbol> :
                {
                  False  = <Tokenize <AddAllSymbols (Lit s.Symbol) e.Rest>>;
                  s.Type = (s.Type s.Symbol) <Tokenize () e.Rest>;
                }
          };
    };
  (e.Token) s.Symbol e.Rest = (e.Token) <Tokenize () s.Symbol e.Rest>;
  (e.Token) = e.Token;
  () = /* empty */;
}

AddAllSymbols {
  (Lit e.Symbols) s.Symbol e.Rest = <IsSpace s.Symbol> : 
      {
        True  = <AddAllSymbols (Lit e.Symbols) e.Rest>;
        False = <IsUpper (<Variables>) s.Symbol> :
            {
              True  = (Lit e.Symbols) s.Symbol e.Rest;
              False = <AddAllSymbols (Lit e.Symbols s.Symbol) e.Rest>;
            };
      };
  (Lit e.Symbols) = (Lit e.Symbols);
}

TakeVarInBrackets {
  (s.CountVars) (Start s.Symbol) e.Rest = '^      -> ^(>)' '\n' <TakeVarInBrackets (s.CountVars) e.Rest>;
  (s.CountVars) (End s.Symbol) e.Rest = '(>)$   -> (<)$' '\n' <TakeVarInBrackets (s.CountVars) e.Rest>;
  (s.CountVars) (Var s.Symbol) (Lit e.Symbols) e.Rest 
    = '(>)γ   -> ' <Symb s.CountVars>'[γ('<Symb s.CountVars>'>)'      '\n'
      '('<Symb s.CountVars>'>)γ    -> γ('<Symb s.CountVars>'>)'           '\n'
      '('<Symb s.CountVars>'>)'e.Symbols' -> ]'<Symb s.CountVars>'(>)'e.Symbols '\n'
      <TakeVarInBrackets (<Add s.CountVars 1>) (Lit e.Symbols) e.Rest>;
  (s.CountVars) (Var s.Symbol1) (End s.Symbol2) e.Rest 
    = '(>)γ   -> ' <Symb s.CountVars>'[γ('<Symb s.CountVars>'>)'         '\n'
      '('<Symb s.CountVars>'>)γ  -> γ('<Symb s.CountVars>'>)'            '\n'
      '('<Symb s.CountVars>'>)'s.Symbol2'  -> ]'<Symb s.CountVars>'(>)$' '\n'
      <TakeVarInBrackets (s.CountVars) (End s.Symbol2) e.Rest>;
  (s.CountVars) (Var s.Symbol1) (Var s.Symbol2) e.Rest 
    = '(>)γ   -> ' <Symb s.CountVars>'[]'<Symb s.CountVars>'(>)γ'     '\n'
      <TakeVarInBrackets (<Add s.CountVars 1>) (Var s.Symbol2) e.Rest>;
  (s.CountVars) (Lit e.Symbols) e.Rest 
    = '(>)'e.Symbols '  -> 'e.Symbols'(>)' '\n' 
      <TakeVarInBrackets (s.CountVars) e.Rest>;
  (s.CountVars)  = /* empty */;
}

DeleteAllLiterals {
  (s.CountVars) e.Rest (End s.Symbol) = <DeleteAllLiterals (s.CountVars) e.Rest>;
  (s.CountVars) e.Rest (Lit e.Symbols) = e.Symbols'(<)  -> (<)' '\n' <DeleteAllLiterals (s.CountVars) e.Rest>;
  (s.CountVars) e.Rest (Var s.Symbol)  
    = ']'<Symb s.CountVars>'(<)  -> (<'<Symb s.CountVars>')]'<Symb s.CountVars> '\n' 
      'γ(<'<Symb s.CountVars>')  -> (<'<Symb s.CountVars>')γ' '\n'
      <Symb s.CountVars>'[(<'<Symb s.CountVars>') -> (<)'<Symb s.CountVars>'[' '\n'
      <DeleteAllLiterals (<Sub s.CountVars 1>) e.Rest>;
  (s.CountVars) e.Rest (Start s.Symbol) = '^(<)   -> ^(>)' '\n' <DeleteAllLiterals (s.CountVars) e.Rest>;
  (0) = /* empty */;
}

CountVars {
  (s.CountVars) (Var s.Name) e.Rest = <CountVars (<Add s.CountVars 1>) e.Rest>;
  (s.CountVars) (s.Type e.Symbols) e.Rest = <CountVars (s.CountVars) e.Rest>;
  (s.CountVars) = s.CountVars
}

CopyingVars {
  (Start s.Symbol) e.Rest1 ((Start s.Symbol) e.Rest2) 1 (e.Acc) = <CopyingVars e.Rest1 (e.Rest2) 1 (e.Acc)>;
  (End s.Symbol) e.Rest1 ((End s.Symbol) e.Rest2) s.CountVars (e.Acc) = '(>)'s.Symbol'   -> (<)'s.Symbol '\n';
  (Lit e.Symbols1) e.Rest1 ((s.Type e.Symbols2) e.Rest2) s.CountVar (e.Acc) 
    = <CopyingVars e.Rest1 ((s.Type e.Symbols2) e.Rest2) s.CountVar (e.Acc)>;
  (s.Type e.Symbols1) e.Rest1 ((Lit e.Symbols2) e.Rest2) s.CountVar (e.Acc) 
    = <CopyingVars (s.Type e.Symbols1) e.Rest1 (e.Rest2) s.CountVar (e.Acc)>;
  (Var s.Name s.Num) e.Rest1 ((Var s.Name s.Num) e.Rest2) s.CountVars (e.Acc)
    = '(>)'<Symb s.Num>'[     -> '<Symb s.Num>'[('<Symb s.Num>'>)' '\n'
      '('<Symb s.Num>'>)γ     -> γ('<Symb s.Num>'>)' '\n'
      '('<Symb s.Num>'>)]'<Symb s.Num>'    -> ]'<Symb s.Num>'(>)' '\n'
      <CopyingVars e.Rest1 (e.Rest2) <Add s.CountVars 1> ((Var s.Name s.Num) e.Acc) >;
  (Var s.Name1 s.Num1) e.Rest1 ((Var s.Name2 s.Num2) e.Rest2) s.CountVars (e.Acc) = <Compare s.CountVars s.Num2> : 
    {
      '-' = '----Начинаем копирование 's.Name2'----\n'
            <CopyVarRight (Var s.Name2 s.Num2) (Var s.Name1 s.Num1) ((Var s.Name1 s.Num1) e.Rest1)>
            '(f'<Symb s.Num2>'\'>)'<Symb s.Num1>'[    -> (>)'<Symb s.Num1>'[' '\n'
            '----Закончили копирование 's.Name2'----\n'
            <CopyingVars (Var s.Name1 s.Num1) e.Rest1 (e.Rest2) s.Num2 ((Var s.Name2 s.Num2) e.Acc)>;
      '+' = '----Начинаем копирование 's.Name2'----\n'
            '(>)'<Symb s.Num1>'[      -> (<\''<Symb s.Num2>'s)'<Symb s.Num2>'[]'<Symb s.Num2><Symb s.Num1>'[' '\n'
            <CopyVarLeft (Var s.Name2 s.Num2) (e.Acc) e.Acc>
            '----Закончили копирование 's.Name2'----\n'
            <CopyingVars (Var s.Name1 s.Num1) e.Rest1 (e.Rest2) s.Num2 ((Var s.Name2 s.Num2) e.Acc)>;
    };
  (End s.Symbol) e.Rest1 ((Var s.Name s.Num) e.Rest2) s.CountVars (e.Acc) 
    = '(>)'s.Symbol'      -> (<\''<Symb s.Num>'s)'<Symb s.Num>'[]'<Symb s.Num>s.Symbol '\n'
      <CopyVarLeft (Var s.Name s.Num) (e.Acc) e.Acc>;
  (Var s.Name s.Num) e.Rest1 ((End s.Symbol)) s.CountVars (e.Acc) 
    = '(>)'<Symb s.Num>'[  -> ('<Symb s.Num>'>)' '\n'
      '('<Symb s.Num>'>)γ  -> ('<Symb s.Num>'>)' '\n'
      '('<Symb s.Num>'>)]'<Symb s.Num>' ->  (>)' '\n'
      <CopyingVars e.Rest1 ((End s.Symbol)) s.CountVars (e.Acc)>;
}

PutNum {
  (e.LeftSide) = /* empty */;
  (Var s.Symbol) e.Rest (e.LeftSide) = (Var s.Symbol <GetNumOf 1 (Var s.Symbol) (e.LeftSide)>) <PutNum e.Rest (e.LeftSide)>;
  (s.Type e.Symbols) e.Rest (e.LeftSide) = (s.Type e.Symbols) <PutNum e.Rest (e.LeftSide)>;
}

GetNumOf {
  s.Count (Var s.Name) ((Var s.Name) e.Rest) = s.Count;
  s.Count (Var s.Name1) ((Var s.Name2) e.Rest) = <GetNumOf <Add s.Count 1> (Var s.Name1) (e.Rest)>;
  s.Count (Var s.Name) ((s.Type e.Symbols) e.Rest) = <GetNumOf s.Count (Var s.Name) (e.Rest)>;
  s.Count (Var s.Name) () = 0;
}

CopyVarRight {
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) ((Var s.NameSearch s.NumSearch) e.Rest) e.Acc
    = <GenCopyRule (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (Var s.NameSearch s.NumSearch) e.Acc>;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) ((Var s.NameStart s.NumStart) e.Rest) 
    = '(>)'<Symb s.NumStart>'[       -> '<Symb s.NumSearch>'[]'<Symb s.NumSearch><Symb s.NumStart>'[(s'<Symb s.NumSearch>'\'>)' '\n'
      '('<Symb s.NumSearch>'\'>)'<Symb s.NumStart>'[     -> '<Symb s.NumStart>'[('<Symb s.NumSearch>'\'>)' '\n'
      '(s'<Symb s.NumSearch>'\'>)γ     -> γ(s'<Symb s.NumSearch>'\'>)''\n'
      '(s'<Symb s.NumSearch>'\'>)]'<Symb s.NumStart>'    -> ]'<Symb s.NumStart>'(s'<Symb s.NumSearch>'\'>)''\n'
      <CopyVarRight (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (e.Rest) (Var s.NameStart s.NumStart)>;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) ((Var s.NameCur s.NumCur) e.Rest) e.Acc
    = '(>)'<Symb s.NumCur>'[  -> '<Symb s.NumCur>'[('<Symb s.NumCur>'>)' '\n'
      '('<Symb s.NumCur>'>)γ  -> γ('<Symb s.NumCur>'>)''\n'
      '('<Symb s.NumCur>'>)]'<Symb s.NumCur>' -> ]'<Symb s.NumCur>'(>)''\n'
      <CopyVarRight (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (e.Rest) (Var s.NameCur s.NumCur) e.Acc>;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) ((Lit e.Symbols) e.Rest) e.Acc 
    =  <GenCopyRule (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (Var s.NameSearch s.NumSearch) e.Acc>;
}

CopyVarLeft {
  (Var s.NameSearch s.NumSearch) ((Var s.NameSearch s.NumSearch)) e.RightSide2 (Var s.NameSearch s.NumSearch)
    = <Symb s.NumSearch>'[]'<Symb s.NumSearch>'(<\''<Symb s.NumSearch>'s) -> '<Symb s.NumSearch>'[]'<Symb s.NumSearch>'(f'<Symb s.NumSearch>'\'>)' '\n'
      'λ]'<Symb s.NumSearch>'(<\''<Symb s.NumSearch>'s)  -> @λ]'<Symb s.NumSearch>'(λ'<Symb s.NumSearch>'\'>)' '\n'
      ']'<Symb s.NumSearch>'(<\''<Symb s.NumSearch>')    -> (<\''<Symb s.NumSearch>')]'<Symb s.NumSearch> '\n'
      'γ(<\''<Symb s.NumSearch>')     -> (<\''<Symb s.NumSearch>')γ' '\n'
      'λ@(<\''<Symb s.NumSearch>')    -> @λ(λ'<Symb s.NumSearch>'\'>)' '\n'
      <Symb s.NumSearch>'[@(<\''<Symb s.NumSearch>')   -> '<Symb s.NumSearch>'[(f'<Symb s.NumSearch>'\'>)' '\n'
      '(λ'<Symb s.NumSearch>'\'>)γ    -> γ(λ'<Symb s.NumSearch>'\'>)' '\n'
      '(f'<Symb s.NumSearch>'\'>)γ    -> γ(f'<Symb s.NumSearch>'\'>)' '\n'
      '(λ'<Symb s.NumSearch>'\'>)]'<Symb s.NumSearch>'   -> ]'<Symb s.NumSearch>'(λ'<Symb s.NumSearch>'\'>)' '\n'
      '(f'<Symb s.NumSearch>'\'>)]'<Symb s.NumSearch>'   -> ]'<Symb s.NumSearch>'(f'<Symb s.NumSearch>'\'>)' '\n'
      <CopyVarLeft (Var s.NameSearch s.NumSearch) () e.RightSide2>;
  (Var s.NameSearch s.NumSearch) ((Var s.NameCur s.NumCur) e.RightSide1) e.RightSide2 
    = ']'<Symb s.NumCur>'(<\''<Symb s.NumSearch>'s)   -> (<\''<Symb s.NumSearch>'s)]'<Symb s.NumCur> '\n'
      'γ(<\''<Symb s.NumSearch>'s)    -> (<\''<Symb s.NumSearch>'s)γ' '\n'
      <Symb s.NumCur>'[(<\''<Symb s.NumSearch>'s)   -> (<\''<Symb s.NumSearch>'s)'<Symb s.NumCur>'[' '\n'
      ']'<Symb s.NumCur>'(<\''<Symb s.NumSearch>')    -> (<\''<Symb s.NumSearch>')]'<Symb s.NumCur> '\n'
      'γ(<\''<Symb s.NumSearch>')     -> (<\''<Symb s.NumSearch>')γ' '\n'
      <Symb s.NumCur>'[(<\''<Symb s.NumSearch>')    -> (<\''<Symb s.NumSearch>')'<Symb s.NumCur>'[' '\n'
      <CopyVarLeft (Var s.NameSearch s.NumSearch) (e.RightSide1) e.RightSide2>;
  (Var s.NameSearch s.NumSearch) () e.RightSide (Var s.NameCur s.NumCur)
    = '(λ'<Symb s.NumSearch>'\'>)'<Symb s.NumCur>'[   -> '<Symb s.NumCur>'[(λ'<Symb s.NumSearch>'\'>)' '\n'
      '(f'<Symb s.NumSearch>'\'>)'<Symb s.NumCur>'[   -> '<Symb s.NumCur>'[(f'<Symb s.NumSearch>'\'>)' '\n'
      '(λ'<Symb s.NumSearch>'\'>)γ    -> γ(λ'<Symb s.NumSearch>'\'>)' '\n'
      '(f'<Symb s.NumSearch>'\'>)γ    -> γ(f'<Symb s.NumSearch>'\'>)' '\n'
      '(λ'<Symb s.NumSearch>'\'>)]'<Symb s.NumCur>'   -> ]'<Symb s.NumCur>'(λ'<Symb s.NumSearch>'\'>)' '\n'
      '(f'<Symb s.NumSearch>'\'>)]'<Symb s.NumCur>'   -> ]'<Symb s.NumCur>'(f'<Symb s.NumSearch>'\'>)' '\n'
      <CopyVarLeft (Var s.NameSearch s.NumSearch) () e.RightSide>;
  (Var s.NameSearch s.NumSearch) () 
    = '(λ'<Symb s.NumSearch>'\'>)'<Symb s.NumSearch>'[   -> '<Symb s.NumSearch>'[(λ'<Symb s.NumSearch>'\'>)' '\n'
      '(f'<Symb s.NumSearch>'\'>)'<Symb s.NumSearch>'[   -> '<Symb s.NumSearch>'[(f'<Symb s.NumSearch>'\'>)' '\n'
      '(λ'<Symb s.NumSearch>'\'>)γ    -> γ(λ'<Symb s.NumSearch>'\'>)' '\n'
      '(f'<Symb s.NumSearch>'\'>)γ    -> γ(f'<Symb s.NumSearch>'\'>)' '\n'
      '(λ'<Symb s.NumSearch>'\'>)]'<Symb s.NumSearch>'   -> (<\''<Symb s.NumSearch>')λ]'<Symb s.NumSearch> '\n'
      '(f'<Symb s.NumSearch>'\'>)]'<Symb s.NumSearch>'   -> ]'<Symb s.NumSearch>'(>)' '\n'
      'γ(<\''<Symb s.NumSearch>')     -> (<\''<Symb s.NumSearch>')γ' '\n'
      <Symb s.NumSearch>'[(<\''<Symb s.NumSearch>')    -> (<\''<Symb s.NumSearch>')'<Symb s.NumSearch>'[' '\n';

}

GenCopyRule {
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (Var s.NameSearch s.NumSearch) e.Rest 
    = '(s'<Symb s.NumSearch>'\'>)'<Symb s.NumSearch>'[]'<Symb s.NumSearch>'  -> (<\''<Symb s.NumSearch>'f)'<Symb s.NumSearch>'[]'<Symb s.NumSearch> '\n'
      '(s'<Symb s.NumSearch>'\'>)'<Symb s.NumSearch>'[λ   -> (<\''<Symb s.NumSearch>'λ)'<Symb s.NumSearch>'[λ@' '\n'
      '('<Symb s.NumSearch>'\'>)'<Symb s.NumSearch>'[     -> '<Symb s.NumSearch>'[('<Symb s.NumSearch>'\'>)' '\n'
      '('<Symb s.NumSearch>'\'>)γ      -> γ('<Symb s.NumSearch>'\'>)' '\n'
      '('<Symb s.NumSearch>'\'>)@λ     -> (<\''<Symb s.NumSearch>'λ)λ@' '\n'
      '('<Symb s.NumSearch>'\'>)@]'<Symb s.NumSearch>'    -> (<\''<Symb s.NumSearch>'f)]'<Symb s.NumSearch> '\n'
      'γ(<\''<Symb s.NumSearch>'λ)     -> (<\''<Symb s.NumSearch>'λ)γ' '\n'
      'γ(<\''<Symb s.NumSearch>'f)     -> (<\''<Symb s.NumSearch>'f)γ' '\n'
      <Symb s.NumSearch>'[(<\''<Symb s.NumSearch>'λ)    -> (<\''<Symb s.NumSearch>'λ)'<Symb s.NumSearch>'[' '\n'
      <Symb s.NumSearch>'[(<\''<Symb s.NumSearch>'f)    -> (<\''<Symb s.NumSearch>'f)'<Symb s.NumSearch>'[' '\n'
      <GenCopyRule (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) e.Rest >;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (Var s.NameCur s.NumCur) e.Rest 
    = ']'<Symb s.NumCur>'(<\''<Symb s.NumSearch>'λ)    -> (<\''<Symb s.NumSearch>'λ)]'<Symb s.NumCur> '\n'
      ']'<Symb s.NumCur>'(<\''<Symb s.NumSearch>'f)    -> (<\''<Symb s.NumSearch>'f)]'<Symb s.NumCur> '\n'
      'γ(<\''<Symb s.NumSearch>'λ)     -> (<\''<Symb s.NumSearch>'λ)γ' '\n'
      'γ(<\''<Symb s.NumSearch>'f)     -> (<\''<Symb s.NumSearch>'f)γ' '\n'
      <Symb s.NumCur>'[(<\''<Symb s.NumSearch>'λ)    -> (<\''<Symb s.NumSearch>'λ)'<Symb s.NumCur>'[' '\n'
      <Symb s.NumCur>'[(<\''<Symb s.NumSearch>'f)    -> (<\''<Symb s.NumSearch>'f)'<Symb s.NumCur>'[' '\n'
      <GenCopyRule (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) e.Rest>;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart)
    = ']'<Symb s.NumSearch>'(<\''<Symb s.NumSearch>'λ)    -> λ]'<Symb s.NumSearch>'('<Symb s.NumSearch>'\'>)' '\n'
      ']'<Symb s.NumSearch>'(<\''<Symb s.NumSearch>'f)    -> ]'<Symb s.NumSearch>'(f'<Symb s.NumSearch>'\'>)' '\n';
}

PutLits {
  e.Rest (End s.Symbol) = <PutLits e.Rest>;
  e.Rest (Var s.Name s.Num) 
    = ']'<Symb s.Num>'(<)  -> (<'<Symb s.Num>')]'<Symb s.Num> '\n'
      'γ(<'<Symb s.Num>')  -> (<'<Symb s.Num>')γ' '\n'
      <Symb s.Num>'[(<'<Symb s.Num>') ->  (<)'<Symb s.Num>'[' '\n'
      <PutLits e.Rest>;
  e.Rest (Var s.Name s.Num) (Lit e.Symbols) 
    = ']'<Symb s.Num>'(<)  ->  ]'<Symb s.Num>'(<)'e.Symbols '\n'
      <PutLits e.Rest (Var s.Name s.Num)>;
  e.Rest (Start s.Symbol) (Lit e.Symbols) 
    = s.Symbol'(<)  ->  's.Symbol e.Symbols'(<)' '\n'
      <PutLits e.Rest (Start s.Symbol)>;
  e.Rest (Start s.Symbol)
    = s.Symbol'(<)   ->  's.Symbol'(>)' '\n';
}

DeleteBrackets {
  (Start s.Symbol) e.Rest = <DeleteBrackets e.Rest>;
  (Lit e.Symbols) e.Rest 
    = '(>)'e.Symbols'    -> 'e.Symbols'(>)' '\n'
      <DeleteBrackets e.Rest>;
  (Var s.Name s.Num) e.Rest 
    = '(>)'<Symb s.Num>'[   ->  ('<Symb s.Num>'>)' '\n'
      '('<Symb s.Num>'>)γ   -> γ('<Symb s.Num>'>)' '\n'
      '('<Symb s.Num>'>)]'<Symb s.Num>'  -> ('<Symb s.Num>'>)' '\n'
      <DeleteBrackets e.Rest>;
  (End s.Symbol) e.Rest 
    = '(>)'s.Symbol '    ->  's.Symbol '\n'
}

IsUpper {
  (e.Left s.Symbol e.Right) s.Symbol = True;
  (e.Vars) s.Symbol = False;
}

Variables {
  = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
}

IsEndOrStart {
  '^' = Start;
  '$' = End;
  s.Symbol = False;
}

IsSpace {
  ' '  = True;
  '\n' = True;
  s.Symbol  = False;
}