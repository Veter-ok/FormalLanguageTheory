* ^XaaYZ$ = ^XZXaYX$
* ^bbaapqr$
* ^1[bb]1 aa 2[]2 3[pqr]3$
* ^1[bb]1 2[]2 3[pqr]3$
* Сортировка началась
* >^1[bb]1 2[]2 3[pqr]3$
* ^1[bb]1 > 2[]2 3[pqr]3$
* ^1[bb]1 3[pqr]3 > 2[]2 3[pqr]3$
* ^1[bb]1 3[pqr]3 1[bb]1 > 2[]2 3[pqr]3$
* ^1[bb]1 3[pqr]3 1[bb]1 2[]2 1[bb]1 > 3[pqr]3$
* ^1[bb]1 3[pqr]3 1[bb]1 2[]2 1[bb]1 $
* Сортировка закончилась
* ^1[bb]1 3[pqr]3 1[bb]1 a 2[]2 1[bb]1 $
* ^bbpqrbbabb$

* (Start ^)(Var X1 )(Var Z3 )(Var X1 )(Lit a)(Var Y2 )(Var X1 )(End $)
* (Start ^)(Var X1 )(Lit aa)(Var Y2 )(Var Z3 )(End $)

$ENTRY Go {
  = <Prout 'Введите правило (например, ^XaaYZ$ = ^XZXaYX$):'>
    <Prout <GenerateSRS <Get 0>>>;
}

GenerateSRS {
  e.LeftSide '=' e.RightSide 
    = '----Оборачивание переменных в скобки----\n' 
      <TakeVarInBrackets (1) <Tokenize () e.LeftSide>>
      '---------Удаление всех литералов--------\n'  
      <DeleteAllLiterals (<CountVars (0) <Tokenize () e.LeftSide>>) <Tokenize () e.LeftSide>>
      '---------Копирование переменных---------\n'
      <PutNum <Tokenize () e.LeftSide> (<Tokenize () e.LeftSide>)>
      '\n'
      <PutNum <Tokenize () e.RightSide> (<Tokenize () e.LeftSide>)>
      '\n'
      <CopyingVars 
        <PutNum <Tokenize () e.LeftSide> (<Tokenize () e.LeftSide>)>
        (<PutNum <Tokenize () e.RightSide> (<Tokenize () e.LeftSide>)>) 
        1
        ()
      >
      '------------Вставка литералов-----------\n'
      '-------------Удаление скобок------------\n';
}

Tokenize {
  () s.Symbol e.Rest = <IsSpace s.Symbol> :
      {
        True  = <Tokenize () e.Rest>;
        False = <IsUpper s.Symbol> :
            {
              True  = (Var s.Symbol) <Tokenize () e.Rest>;
              False = <IsEndOrStart s.Symbol> :
                  {
                    False  = <Tokenize <AddAllSymbols (Lit s.Symbol) e.Rest>>;
                    s.Type = (s.Type s.Symbol) <Tokenize () e.Rest>;
                  }
            };
      };
  (e.Token) s.Symbol e.Rest = (e.Token) <Tokenize () s.Symbol e.Rest>;
  (e.Token) = e.Token;
  () = /* empty */;
}

AddAllSymbols {
  (Lit e.Symbols) s.Symbol e.Rest = <IsSpace s.Symbol> : 
      {
        True  = <AddAllSymbols (Lit e.Symbols) e.Rest>;
        False = <IsUpper s.Symbol> :
            {
              True  = (Lit e.Symbols) s.Symbol e.Rest;
              False = <AddAllSymbols (Lit e.Symbols s.Symbol) e.Rest>;
            };
      };
  (Lit e.Symbols) = (Lit e.Symbols);
}

TakeVarInBrackets {
  (s.CountVars) (Start s.Symbol) e.Rest = '^   -> ^>' '\n' <TakeVarInBrackets (s.CountVars) e.Rest>;
  (s.CountVars) (End s.Symbol) e.Rest = '>$ -> <$' '\n' <TakeVarInBrackets (s.CountVars) e.Rest>;

  (s.CountVars) (Var s.Symbol) (Lit e.Symbols) e.Rest = '>γ  -> ' <Symb s.CountVars>'[γ '<Symb s.CountVars>'>'      '\n'
                                                        <Symb s.CountVars>'>γ -> γ '<Symb s.CountVars>'>'           '\n'
                                                        <Symb s.CountVars>'>'e.Symbols' -> ]'<Symb s.CountVars>' >'e.Symbols '\n'
                                                        <TakeVarInBrackets (<Add s.CountVars 1>) (Lit e.Symbols) e.Rest>;
  (s.CountVars) (Var s.Symbol1) (End s.Symbol2) e.Rest = '>γ  -> ' <Symb s.CountVars>'[γ '<Symb s.CountVars>'>'         '\n'
                                                         <Symb s.CountVars>'>γ -> γ '<Symb s.CountVars>'>'            '\n'
                                                         <Symb s.CountVars>'>'s.Symbol2' -> ]'<Symb s.CountVars>' >$' '\n';
  (s.CountVars) (Var s.Symbol1) (Var s.Symbol2) e.Rest = '>γ  -> ' <Symb s.CountVars>'[]'<Symb s.CountVars>' >γ'     '\n'
                                                         <TakeVarInBrackets (<Add s.CountVars 1>) (Var s.Symbol2) e.Rest>;
  (s.CountVars) (Lit e.Symbols) e.Rest = '>'e.Symbols ' -> 'e.Symbols'>' '\n' <TakeVarInBrackets (s.CountVars) e.Rest>;
  (s.CountVars)  = /* empty */;
}

DeleteAllLiterals {
  (s.CountVars) e.Rest (End s.Symbol)  = <DeleteAllLiterals (s.CountVars) e.Rest>;
  (s.CountVars) e.Rest (Lit e.Symbols) = e.Symbols'< -> <' '\n' <DeleteAllLiterals (s.CountVars) e.Rest>;
  (s.CountVars) e.Rest (Var s.Symbol)  = ']'<Symb s.CountVars>'< -> <'<Symb s.CountVars>' ]'<Symb s.CountVars> '\n' 
                                         'γ<'<Symb s.CountVars> ' -> <' <Symb s.CountVars>'γ' '\n'
                                         <Symb s.CountVars>'[ <'<Symb s.CountVars> ' -> < ' <Symb s.CountVars>'[' '\n'
                                         <DeleteAllLiterals (<Sub s.CountVars 1>) e.Rest>;
  (s.CountVars) e.Rest (Start s.Symbol) = '^< -> ^>' '\n' <DeleteAllLiterals (s.CountVars) e.Rest>;
  (0) = /* empty */;
}

CountVars {
  (s.CountVars) (Var s.Name) e.Rest = <CountVars (<Add s.CountVars 1>) e.Rest>;
  (s.CountVars) (s.Type e.Symbols) e.Rest = <CountVars (s.CountVars) e.Rest>;
  (s.CountVars) = s.CountVars
}

CopyingVars {
  (Start s.Symbol) e.Rest1 ((Start s.Symbol) e.Rest2) 1 (e.Acc)  
    = '^<      -> >^' '\n'
      <CopyingVars e.Rest1 (e.Rest2) 1 (e.Acc)>;
  (End s.Symbol) e.Rest1 ((End s.Symbol) e.Rest2) s.CountVars (e.Acc) = /* empty */;
  (Lit e.Symbols1) e.Rest1 ((s.Type e.Symbols2) e.Rest2) s.CountVar (e.Acc) 
    = <CopyingVars e.Rest1 ((s.Type e.Symbols2) e.Rest2) s.CountVar (e.Acc)>;
  (s.Type e.Symbols1) e.Rest1 ((Lit e.Symbols2) e.Rest2) s.CountVar (e.Acc) 
    = <CopyingVars (s.Type e.Symbols1) e.Rest1 (e.Rest2) s.CountVar (e.Acc)>;
  (Var s.Name s.Num) e.Rest1 ((Var s.Name s.Num) e.Rest2) s.CountVars (e.Acc)
    = '>'<Symb s.Num>'[     -> '<Symb s.Num>'['<Symb s.Num>'>' '\n'
      <Symb s.Num>'>γ     -> γ'<Symb s.Num>'>' '\n'
      <Symb s.Num>'>]'<Symb s.Num>'    -> ]'<Symb s.Num>'>' '\n'
      <CopyingVars e.Rest1 (e.Rest2) <Add s.CountVars 1> ((Var s.Name s.Num) e.Acc) >;
  (Var s.Name1 s.Num1) e.Rest1 ((Var s.Name2 s.Num2) e.Rest2) s.CountVars (e.Acc) = <Compare s.CountVars s.Num2> : 
    {
      '-' = '----Начинаем копирование 's.Name2'----\n'
            <CopyVarLeft (Var s.Name2 s.Num2) (Var s.Name1 s.Num1) ((Var s.Name1 s.Num1) e.Rest1)>
            <Symb s.Num2>'\'>'<Symb s.Num1>'[   -> >'<Symb s.Num1>'[' '\n'
            '----Закончили копирование 's.Name2'----\n'
            <CopyingVars (Var s.Name1 s.Num1) e.Rest1 (e.Rest2) s.Num2 ((Var s.Name2 s.Num2) e.Acc)>;
      '+' = '----Начинаем копирование 's.Name2'----\n'
            '>'<Symb s.Num1>'[     -> <\''<Symb s.Num2><Symb s.Num1>'[' '\n'
            <CopyVarRight (Var s.Name2 s.Num2) (e.Acc) e.Acc>
            '----Закончили копирование 's.Name2'----\n'
            <CopyingVars (Var s.Name1 s.Num1) e.Rest1 (e.Rest2) s.Num2 ()>;
    };
  (End s.Symbol) e.Rest1 ((Var s.Name s.Num) e.Rest2) s.CountVars (e.Acc) = 'что-то 1\n';
  (Var s.Name s.Num) e.Rest1 ((End s.Symbol)) s.CountVars (e.Acc) 
    = '>'<Symb s.Num>'[  -> '<Symb s.Num>'>' '\n'
      <Symb s.Num>'>γ  -> '<Symb s.Num>'>' '\n'
      <Symb s.Num>'>]'<Symb s.Num>' -> >' '\n'
      <CopyingVars e.Rest1 ((End s.Symbol)) s.CountVars (e.Acc)>;
}

PutNum {
  (e.LeftSide) = /* empty */;
  (Var s.Symbol) e.Rest (e.LeftSide) = (Var s.Symbol <GetNumOf 1 (Var s.Symbol) (e.LeftSide)>) <PutNum e.Rest (e.LeftSide)>;
  (s.Type e.Symbols) e.Rest (e.LeftSide) = (s.Type e.Symbols) <PutNum e.Rest (e.LeftSide)>;
}

GetNumOf {
  s.Count (Var s.Name) ((Var s.Name) e.Rest) = s.Count;
  s.Count (Var s.Name1) ((Var s.Name2) e.Rest) = <GetNumOf <Add s.Count 1> (Var s.Name1) (e.Rest)>;
  s.Count (Var s.Name) ((s.Type e.Symbols) e.Rest) = <GetNumOf s.Count (Var s.Name) (e.Rest)>;
}

CopyVarLeft {
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) ((Var s.NameSearch s.NumSearch) e.Rest) e.Acc
    = <GenCopyRule (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (Var s.NameSearch s.NumSearch) e.Acc>;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) ((Var s.NameStart s.NumStart) e.Rest) 
    = '>'<Symb s.NumStart>'[     -> '<Symb s.NumSearch>'[]'<Symb s.NumSearch><Symb s.NumStart>'['<Symb s.NumSearch>'\'>' '\n'
      <Symb s.NumSearch>'\'>γ    -> γ'<Symb s.NumSearch>'\'>''\n'
      <Symb s.NumSearch>'\'>]'<Symb s.NumStart>'   -> ]'<Symb s.NumStart><Symb s.NumSearch>'\'>''\n'
      <CopyVarLeft (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (e.Rest) (Var s.NameStart s.NumStart)>;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) ((Var s.NameCur s.NumCur) e.Rest) e.Acc
    = '>'<Symb s.NumCur>'[  -> '<Symb s.NumCur>'['<Symb s.NumCur>'>' '\n'
      <Symb s.NumCur>'>γ  -> γ'<Symb s.NumCur>'>''\n'
      <Symb s.NumCur>'>]'<Symb s.NumCur>' -> ]'<Symb s.NumCur>'>''\n'
      <CopyVarLeft (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (e.Rest) (Var s.NameCur s.NumCur) e.Acc>;
}

CopyVarRight {
  (Var s.NameSearch s.NumSearch) ((Var s.NameSearch s.NumSearch)) e.RightSide2 (Var s.NameSearch s.NumSearch)
    = 'λ]'<Symb s.NumSearch>'<\''<Symb s.NumSearch>'  -> ]'<Symb s.NumSearch>'λ'<Symb s.NumSearch>'\'>' '\n'
      <CopyVarRight (Var s.NameSearch s.NumSearch) () e.RightSide2>;
  (Var s.NameSearch s.NumSearch) ((Var s.NameCur s.NumCur) e.RightSide1) e.RightSide2 
    = ']'<Symb s.NumCur>'<\''<Symb s.NumSearch>'   -> <\''<Symb s.NumSearch>']'<Symb s.NumCur> '\n'
      'γ<\''<Symb s.NumSearch>'    -> <\''<Symb s.NumSearch>'γ' '\n'
      <Symb s.NumCur>'[<\''<Symb s.NumSearch>'   -> <\''<Symb s.NumSearch><Symb s.NumCur>'[' '\n'
      <CopyVarRight (Var s.NameSearch s.NumSearch) (e.RightSide1) e.RightSide2>;
  (Var s.NameSearch s.NumSearch) () (Var s.NameCur s.NumCur)
    = 'λ'<Symb s.NumSearch>'\'>'<Symb s.NumCur>'[  -> '<Symb s.NumCur>'[λ'<Symb s.NumSearch>'\'>' '\n'
      'λ'<Symb s.NumSearch>'\'>γ   -> γλ'<Symb s.NumSearch>'\'>' '\n'
      'λ'<Symb s.NumSearch>'\'>]'<Symb s.NumCur>'  -> ]'<Symb s.NumCur>'λ'<Symb s.NumSearch>'\'>' '\n'
      'λ'<Symb s.NumSearch>'\'>'<Symb s.NumSearch>'[  -> <\''<Symb s.NumSearch><Symb s.NumSearch>'[λ' '\n';
  (Var s.NameSearch s.NumSearch) () e.RightSide (Var s.NameCur s.NumCur)
    = 'λ'<Symb s.NumSearch>'\'>'<Symb s.NumCur>'[  -> '<Symb s.NumCur>'[λ'<Symb s.NumSearch>'\'>' '\n'
      'λ'<Symb s.NumSearch>'\'>γ   -> γλ'<Symb s.NumSearch>'\'>' '\n'
      'λ'<Symb s.NumSearch>'\'>]'<Symb s.NumCur>'  -> ]'<Symb s.NumCur>'λ'<Symb s.NumSearch>'\'>' '\n'
      <CopyVarRight (Var s.NameSearch s.NumSearch) () e.RightSide>;
}

GenCopyRule {
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (Var s.NameSearch s.NumSearch) e.Rest 
    = <Symb s.NumSearch>'\'>'<Symb s.NumSearch>'[   -> '<Symb s.NumSearch>'['<Symb s.NumSearch>'\'>' '\n'
      <Symb s.NumSearch>'\'>λ    -> <\''<Symb s.NumSearch>'λ''\n'
      <Symb s.NumSearch>'[<\''<Symb s.NumSearch>'λ  -> <\''<Symb s.NumSearch>'λ'<Symb s.NumSearch>'[' '\n'
      <GenCopyRule (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) e.Rest >;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) (Var s.NameCur s.NumCur) e.Rest 
    = ']'<Symb s.NumCur>'<\''<Symb s.NumSearch>'λ  -> <\''<Symb s.NumSearch>'λ]'<Symb s.NumCur> '\n'
      'γ<\''<Symb s.NumSearch>'λ   -> <\''<Symb s.NumSearch>'λγ' '\n'
      <Symb s.NumCur>'[<\''<Symb s.NumSearch>'λ  -> <\''<Symb s.NumSearch>'λ'<Symb s.NumCur>'[' '\n'
      <GenCopyRule (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart) e.Rest>;
  (Var s.NameSearch s.NumSearch) (Var s.NameStart s.NumStart)
    = ']'<Symb s.NumSearch>'<\''<Symb s.NumSearch>'λ  -> λ]'<Symb s.NumSearch><Symb s.NumSearch>'\'>' '\n';
}

IsUpper {
  'A' = True;  'B' = True;  'C' = True;  'D' = True;
  'E' = True;  'F' = True;  'G' = True;  'H' = True;
  'I' = True;  'J' = True;  'K' = True;  'L' = True;
  'M' = True;  'N' = True;  'O' = True;  'P' = True;
  'Q' = True;  'R' = True;  'S' = True;  'T' = True;
  'U' = True;  'V' = True;  'W' = True;  'X' = True;
  'Y' = True;  'Z' = True;
  s.Symbol = False;
}

IsEndOrStart {
  '^' = Start;
  '$' = End;
  s.Symbol = False;
}

IsSpace {
  ' '  = True;
  '\n' = True;
  s.Symbol  = False;
}