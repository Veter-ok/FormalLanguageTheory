$ENTRY Go {
    = <GenerateREG <Card>>;
}

GenerateREG {
    e.Input = <Prout <ConvertToREG <RidOfDEL <GenerateTree <Tokenize e.Input>>>>>;
}

Tokenize {
    '*' e.String-E = (MUL '*') <Tokenize e.String-E>;
    '(' e.String-E = (OPEN '(') <Tokenize e.String-E>;
    ')' e.String-E = (CLOSE ')') <Tokenize e.String-E>;
    '\\' e.String-E = (DEL '\\') <Tokenize e.String-E>;
    '|' e.String-E = (CHOICE '|') <Tokenize e.String-E>;
    s.Symbol e.String-E = <IsLetter s.Symbol <Alfabet>> :
    {
        TRUE  = <Tokenize <AddAllSymbols (CONST s.Symbol) e.String-E>>;
        FALSE = (ERROR s.Symbol) <Tokenize e.String-E>;
    };
    (e.Token) s.Symbol e.String-E = (e.Token) <Tokenize s.Symbol e.String-E>;
    (e.Token) = (e.Token);
    /* empty */ = /* empty */;
}

AddAllSymbols {
    (CONST e.Symbols) s.Symbol '*' e.Tokens-E = (CONST e.Symbols) s.Symbol '*' e.Tokens-E;
    (CONST e.Symbols) s.Symbol e.Tokens-E = <IsLetter s.Symbol <Alfabet>> :
    {
        TRUE  = <AddAllSymbols (CONST e.Symbols s.Symbol) e.Tokens-E>;
        FALSE = (CONST e.Symbols) s.Symbol e.Tokens-E;
    };
    (CONST e.Symbols) = (CONST e.Symbols);
}

GenerateTree {
    e.Tokens = <BuildTree DEL <Split DEL 0 () () e.Tokens>>;
}

BuildTree {
    DEL (e.Tokens) = <BuildTree CHOICE <Split CHOICE 0 () () e.Tokens>>;
    DEL e.Parts (e.Last) =
        (DEL <Wrap <BuildTree DEL e.Parts>>
             <Wrap <BuildTree CHOICE <Split CHOICE 0 () () e.Last>>>);
    CHOICE (e.Tokens) = <GenerateSeq e.Tokens>;
    CHOICE e.Alts = (OPTION <WrapAlts e.Alts>);
}

WrapAlts {
    (e.Tokens) e.Rest = <Wrap <GenerateSeq e.Tokens>> <WrapAlts e.Rest>;
    /* empty */       = /* empty */;
}

Wrap {
    (e.Node) = (e.Node);
    e.Nodes  = (SEQ e.Nodes);
}

Split {
    s.Sep 0 (e.Alts) (e.Cur) (s.Sep s.Char) e.Tokens-E = <Split s.Sep 0 (e.Alts (e.Cur)) () e.Tokens-E>;
    s.Sep s.Depth (e.Alts) (e.Cur) (OPEN '(') e.Tokens-E = <Split s.Sep <Add s.Depth 1> (e.Alts) (e.Cur (OPEN '(')) e.Tokens-E>;
    s.Sep s.Depth (e.Alts) (e.Cur) (CLOSE ')') e.Tokens-E = <Split s.Sep <Sub s.Depth 1> (e.Alts) (e.Cur (CLOSE ')')) e.Tokens-E>;
    s.Sep s.Depth (e.Alts) (e.Cur) t.Token e.Tokens-E = <Split s.Sep s.Depth (e.Alts) (e.Cur t.Token) e.Tokens-E>;
    s.Sep s.Depth (e.Alts) (e.Cur) = e.Alts (e.Cur);
}

GenerateSeq {
    e.Tokens-B (CONST e.Symbols) (MUL '*') = <GenerateSeq e.Tokens-B> (MUL (CONST e.Symbols));
    e.Tokens-B (CLOSE ')') (MUL '*')
        = <GenerateSeq <GetAllOutBrackets 0 e.Tokens-B>>
          (MUL <Wrap <GenerateTree <GetAllInBrackets 0 e.Tokens-B>>>);
    e.Tokens-B (CLOSE ')')
        = <GenerateSeq <GetAllOutBrackets 0 e.Tokens-B>>
          <GenerateTree <GetAllInBrackets 0 e.Tokens-B>>;
    e.Tokens-B (CONST e.Symbols) = <GenerateSeq e.Tokens-B> (CONST e.Symbols);
    /* empty */ = /* empty */;
}

GetAllInBrackets {
    0 e.Tokens-B (OPEN '(') = /* empty */;
    s.Count e.Tokens-B (CLOSE ')') = <GetAllInBrackets <Add s.Count 1> e.Tokens-B> (CLOSE ')');
    s.Count e.Tokens-B (OPEN '(') = <GetAllInBrackets <Sub s.Count 1> e.Tokens-B> (OPEN '(');
    s.Count e.Tokens-B (s.Token e.Symbols) = <GetAllInBrackets s.Count e.Tokens-B> (s.Token e.Symbols);
}

GetAllOutBrackets {
    TAKE e.Tokens-B (s.Token e.Symbols) =  <GetAllOutBrackets TAKE e.Tokens-B> (s.Token e.Symbols);
    TAKE = /* empty */;
    0 e.Tokens-B (OPEN '(') =  <GetAllOutBrackets TAKE e.Tokens-B>;
    s.Count e.Tokens-B (CLOSE ')') = <GetAllOutBrackets <Add s.Count 1> e.Tokens-B>;
    s.Count e.Tokens-B (OPEN '(') = <GetAllOutBrackets <Sub s.Count 1> e.Tokens-B>;
    s.Count e.Tokens-B (s.Token e.Symbols) = <GetAllOutBrackets s.Count e.Tokens-B>;
}

RidOfDEL {
    (MUL e.Operands) e.Tokens-E = (MUL <RidOfDEL e.Operands>) <RidOfDEL e.Tokens-E>;
    (OPTION e.Operands) e.Tokens-E = (OPTION <RidOfDEL e.Operands>) <RidOfDEL e.Tokens-E>;
    (DEL e.Operands) e.Tokens-E = (DEL <RidOfDEL e.Operands>) <RidOfDEL e.Tokens-E>;
    (CONST e.Symbols) e.Tokens-E = (CONST e.Symbols) <RidOfDEL e.Tokens-E>;
    (SEQ e.Operands) e.Tokens-E = (SEQ <RidOfDEL e.Operands>) <RidOfDEL e.Tokens-E>;
    /* empty */ = /* empty */;
}

ConvertToREG {
    (MUL (CONST e.Symbols)) e.Tokens-E = '('e.Symbols')*' <ConvertToREG e.Tokens-E>;
    (MUL t.Operand) e.Tokens-E = <ConvertToREG t.Operand>'*' <ConvertToREG e.Tokens-E>;
    (MUL e.Operands) e.Tokens-E = '('<ConvertToREG e.Operands>')*' <ConvertToREG e.Tokens-E>;
    (OPTION e.Operands) e.Tokens-E = '('<ConvertOptionToREG e.Operands>')' <ConvertToREG e.Tokens-E>;
    (DEL t.Operand1 t.Operand2) e.Tokens-E = 
        '('<ConvertToREG t.Operand1> '\\' <ConvertToREG t.Operand2>')' <ConvertToREG e.Tokens-E>;
    (CONST e.Symbols) e.Tokens-E = e.Symbols <ConvertToREG e.Tokens-E>;
    (SEQ e.Operands) e.Tokens-E = (SEQ <ConvertToREG e.Operands>) <ConvertToREG e.Tokens-E>;
    /* empty */ = /* empty */;
}

ConvertOptionToREG {
    (CONST e.Symbols) = e.Symbols;
    (s.Type e.Operands) = <ConvertToREG e.Operands>;
    (CONST e.Symbols) e.Operand-E = e.Symbols '|' <ConvertOptionToREG e.Operand-E>;
    (s.Type e.Operands) e.Operand-E = <ConvertToREG e.Operands> '|' <ConvertOptionToREG e.Operand-E>;
}

Alfabet {
    = ('abcdefghijklmnopqrstuvwxyz')
}

IsLetter {
    s.Symbol (e.Alfabet-B s.Symbol e.Alfabet-E) = TRUE;
    s.Symbol (e.Alfabet) = FALSE;
}